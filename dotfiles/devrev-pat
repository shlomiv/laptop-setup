#!/bin/zsh
set -euo pipefail

SERVICE="devrev-pat"
LOGO_B64=""

read_secret() {
  local name="$1" action="$2"
  local icon=$(mktemp /tmp/devrev-logo.XXXXXX.png)
  echo "$LOGO_B64" | base64 -d > "$icon"
  local result
  result=$(osascript -e "display dialog \"Enter the new token value for '$name':\" with title \"DevRev PAT — $action\" default answer \"\" with hidden answer with icon POSIX file \"$icon\"" \
            -e 'text returned of result' 2>/dev/null) || { rm -f "$icon"; echo "Error: dialog cancelled." >&2; return 1; }
  rm -f "$icon"
  printf '%s' "$result"
}

usage() {
  echo "Usage: devrev-pat <command> [args]"
  echo ""
  echo "Commands:"
  echo "  list                    List all PAT names"
  echo "  get <name>              Get a PAT value"
  echo "  add <name> [value]      Add a new PAT (prompts for value if omitted)"
  echo "  remove <name>           Remove a PAT"
  echo "  rotate <name> [value]   Rotate an existing PAT (prompts for value if omitted)"
}

cmd_list() {
  security dump-keychain | grep -A4 "\"$SERVICE\"" | awk -F'"' '/acct/{print $4}'
}

cmd_get() {
  if [ -z "${1:-}" ]; then
    echo "Usage: devrev-pat get <name>" >&2
    return 1
  fi
  security find-generic-password -s "$SERVICE" -a "$1" -w
}

cmd_add() {
  if [ -z "${1:-}" ]; then
    echo "Usage: devrev-pat add <name> [value]" >&2
    return 1
  fi
  if security find-generic-password -s "$SERVICE" -a "$1" >/dev/null 2>&1; then
    echo "Error: PAT '$1' already exists. Use 'devrev-pat rotate' to update it." >&2
    return 1
  fi
  local value="${2:-}"
  if [ -z "$value" ]; then
    value=$(read_secret "$1" "Add")
  fi
  security add-generic-password -s "$SERVICE" -a "$1" -w "$value"
  echo "Added PAT '$1'"
}

cmd_remove() {
  if [ -z "${1:-}" ]; then
    echo "Usage: devrev-pat remove <name>" >&2
    return 1
  fi
  security delete-generic-password -s "$SERVICE" -a "$1" >/dev/null 2>&1
  echo "Removed PAT '$1'"
}

cmd_rotate() {
  if [ -z "${1:-}" ]; then
    echo "Usage: devrev-pat rotate <name> [value]" >&2
    return 1
  fi
  if ! security find-generic-password -s "$SERVICE" -a "$1" >/dev/null 2>&1; then
    echo "Error: PAT '$1' not found. Use 'devrev-pat list' to see available names." >&2
    return 1
  fi
  local value="${2:-}"
  if [ -z "$value" ]; then
    value=$(read_secret "$1" "Rotate")
  fi
  security delete-generic-password -s "$SERVICE" -a "$1" >/dev/null 2>&1
  security add-generic-password -s "$SERVICE" -a "$1" -w "$value"
  echo "Rotated PAT '$1'"
}

case "${1:-}" in
  list)   cmd_list ;;
  get)    cmd_get "${2:-}" ;;
  add)    cmd_add "${2:-}" "${3:-}" ;;
  remove) cmd_remove "${2:-}" ;;
  rotate) cmd_rotate "${2:-}" "${3:-}" ;;
  *)      usage ;;
esac
