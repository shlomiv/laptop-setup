#!/usr/bin/env python3
"""
Tiny HTTP server that redirects to logseq:// deep links.

Resolves the current graph name dynamically from Logseq's API so links
never break when the graph folder is renamed.

Accepts any graph name in the URL path (or none) and replaces it with
the actual loaded graph:
  http://localhost:12316/block-id=<uuid>
  http://localhost:12316/graph/anything?block-id=<uuid>
  →  logseq://graph/<actual-graph>?block-id=<uuid>
"""

import http.server
import json
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request


def _focus_logseq():
    """Bring Logseq to the foreground and follow to its Space.

    Uses `open -a Logseq` (LaunchServices) rather than an AppleScript
    `activate`. IMPORTANT: this server runs under launchd (see the
    com.shlomi.logseq-link-server LaunchAgent), and launchd-spawned
    processes cannot send Apple Events without Automation (TCC) permission
    — so `osascript ... activate` silently fails here. `open` goes through
    LaunchServices, needs no Automation grant, and works from launchd.

    Fired from a background thread after a delay so the logseq:// protocol
    handler finishes its OWN activation (it activates Logseq to navigate)
    before our `open -a` lands — otherwise the two race and macOS can settle
    back on the original Space.

    TUNING RULE (the only knob that matters): ONLY INCREASING THE DELAY
    helps. Swapping the command (e.g. to `osascript activate`) does NOT —
    that primitive does not switch Spaces at all (confirmed twice). 250ms
    was verified reliable; 100ms (current) is the tuned-down value. If
    space-switching regresses to "occasional," the fix is to RAISE this
    delay — nothing else.

    Full diagnosis / history in DM:
    https://app.devrev.ai/devrev/computer/dm?chatId=don%3Acore%3Advrv-us-1%3Adevo%2F0%3Adm%2FrKtD9GXT

    NOTE: macOS only follows the app to its Space when the Mission Control
    setting "When switching to an application, switch to a Space with open
    windows for the application" is ON (Dock pref `workspaces-auto-swoosh`).
    Verified ON here (lone `open -a` from terminal switches Space reliably),
    so it's not the usual suspect.
    """
    def run():
        time.sleep(0.10)
        subprocess.Popen(
            ["open", "-a", "Logseq"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    threading.Thread(target=run, daemon=True).start()

PORT = 12316
LOGSEQ_API = "http://localhost:12315/api"

# Cache graph name for 60s to avoid hitting the API on every click
_graph_cache = {"name": None, "ts": 0}


def _get_token():
    """Retrieve the Logseq API token from Keychain."""
    try:
        result = subprocess.run(
            ["security", "find-generic-password", "-s", "devrev-pat", "-a", "logseq-kg", "-w"],
            capture_output=True, text=True, timeout=5,
        )
        return result.stdout.strip()
    except Exception:
        return None


def _get_graph_name():
    """Query Logseq API for the current graph name, with caching."""
    now = time.time()
    if _graph_cache["name"] and (now - _graph_cache["ts"]) < 60:
        return _graph_cache["name"]

    token = _get_token()
    if not token:
        return _graph_cache["name"] or "journal"

    try:
        req = urllib.request.Request(
            LOGSEQ_API,
            data=json.dumps({"method": "logseq.App.getCurrentGraph", "args": []}).encode(),
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {token}"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=3) as resp:
            data = json.loads(resp.read())
            name = data.get("name", "journal")
            _graph_cache["name"] = name
            _graph_cache["ts"] = now
            return name
    except Exception:
        return _graph_cache["name"] or "journal"


class RedirectHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        graph_name = _get_graph_name()

        # Parse the incoming URL
        parsed = urllib.parse.urlparse(self.path)
        query = parsed.query  # e.g. "block-id=abc123" or "page=Some%20Page"

        # Build logseq:// deep link with the real graph name
        logseq_uri = f"logseq://graph/{graph_name}?{query}" if query else f"logseq://graph/{graph_name}"

        # 302 redirect to trigger the protocol handler and navigate Logseq
        # to the block.
        self.send_response(302)
        self.send_header("Location", logseq_uri)
        self.end_headers()

        # Then bring Logseq to the front and follow to its Space via a
        # delayed AppleScript activate (background thread, non-blocking).
        _focus_logseq()

    def do_HEAD(self):
        # Some clients probe with HEAD; just return 200
        self.send_response(200)
        self.end_headers()

    def log_message(self, format, *args):
        # Suppress request logs
        pass


if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else PORT
    server = http.server.HTTPServer(("127.0.0.1", port), RedirectHandler)
    print(f"logseq-link-server running on http://localhost:{port}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
